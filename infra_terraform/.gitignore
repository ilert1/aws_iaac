# Terraform state files — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files with real values
terraform.tfvars

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Build artifacts for Lambda packaging
.build/

# Crash logs
crash.log
crash.*.log

# Override files (local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
